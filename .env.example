# ── Lead / form email delivery (Resend) ──────────────────────────────
# Copy this file to `.env` (or set these in your hosting provider) to enable
# real delivery of contact/demo requests and newsletter signups.
# Without RESEND_API_KEY + LEAD_TO_EMAIL, submissions are logged but not emailed.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives demo requests and newsletter signups
LEAD_TO_EMAIL=sales@bluewhalestack.com

# Verified sender (domain must be verified in Resend). Falls back to the
# Resend sandbox sender if unset, which only delivers to the account owner.
LEAD_FROM_EMAIL="BlueWhale Stack <noreply@bluewhalestack.com>"

# ── Content editing (Sanity CMS) ────────────────────────────────────
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty and the site renders from its
# typed content files. Set it (and redeploy) to read published CMS content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the publish webhook: POST /api/revalidate?secret=...
SANITY_REVALIDATE_SECRET=
# Write token — ONLY for the one-off migration script (scripts/sanity/seed.ts);
# never set this on the hosting provider.
SANITY_API_WRITE_TOKEN=
