# Copy to studio/.env for `npm run dev` / `npm run deploy` inside studio/
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# the hostname part of https://<host>.sanity.studio
SANITY_STUDIO_HOST=bluewhalestack
# the website the Presentation tool previews (defaults to production)
SANITY_STUDIO_PREVIEW_ORIGIN=https://bluewhalestack-website-production-6507.up.railway.app
